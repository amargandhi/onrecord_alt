# Local credentials — commit only the empty template.
.env
.env.*
!.env.example

# Python and tooling caches.
.venv/
__pycache__/
.pytest_cache/
*.egg-info/

# Generated runs, indexes, and private working data.
outputs/
local-data/
fixtures/media/
library-capsule.sqlite
*.sqlite-shm
*.sqlite-wal

# Private or generated media. Public screenshots must be reviewed and placed
# deliberately under docs/ before they are committed.
*.mp4
*.mov
*.mkv
*.m4a
*.wav
*.vtt
*.srt

.DS_Store

